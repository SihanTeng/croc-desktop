<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="croc-desktop"
        Arguments=""
        InstallLocation="C:\Program Files\croc\croc-desktop">
    </Installer>
    <PackageInformation
        PackageName="croc-desktop"
        PackageDisplayName="croc-desktop"
        PublisherName="CN=croc"
        PublisherDisplayName="croc"
        Version="0.2.0.0"
        PackageDescription="Desktop GUI for croc — encrypted peer-to-peer file transfer">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.schollz.croc-desktop"
                Description="Desktop GUI for croc — encrypted peer-to-peer file transfer"
                DisplayName="croc-desktop"
                ExecutableName="croc-desktop"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>croc-desktop</DisplayName>
            <PublisherDisplayName>croc</PublisherDisplayName>
            <Description>Desktop GUI for croc — encrypted peer-to-peer file transfer</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="croc-desktop.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
