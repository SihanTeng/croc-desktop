<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="croc-desktop"
           Language="1033"
           Version="0.2.0.0"
           Manufacturer="SihanTeng"
           UpgradeCode="8fca5e75-eb3b-4dcf-b7cc-c482df60c3fc">

    <Package InstallerVersion="200" Compressed="yes" InstallScope="perMachine" Platform="x64"
             Description="croc-desktop — GUI for croc: encrypted peer-to-peer file transfer" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of croc-desktop is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="croc.ico" SourceFile="build\appicon.ico" />
    <Property Id="ARPPRODUCTICON" Value="croc.ico" />

    <Feature Id="MainFeature" Title="croc" Level="1">
      <ComponentGroupRef Id="CrocFiles" />
      <ComponentGroupRef Id="CrocShortcuts" />
    </Feature>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="croc-desktop" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="CrocMenuDir" Name="croc-desktop" />
      </Directory>
    </Directory>

    <ComponentGroup Id="CrocFiles" Directory="INSTALLFOLDER">
      <Component Id="CrocExe" Guid="*" Win64="yes">
        <File Id="crocgui.exe" Source="bin\croc-desktop.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="CrocShortcuts" Directory="CrocMenuDir">
      <Component Id="CrocShortcut" Guid="*" Win64="yes">
        <Shortcut Id="CrocStartMenu"
                  Name="croc-desktop"
                  Description="Transfer files between computers"
                  Target="[INSTALLFOLDER]croc-desktop.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="croc.ico" />
        <RemoveFile Id="RemoveShortcut" Name="*" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\croc-desktop" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Product>
</Wix>
